@model IEnumerable<Drink>
@{
    ViewData["Title"] = "Cocktail Menu";
}

<h1>Cocktail Menu</h1>
<p>Pick a cocktail below to place your order.</p>

<div class="row">
    @foreach (var drink in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@drink.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@drink.Price.ToString("C")</h6>
                    <p class="card-text">@drink.Description</p>
                    <a class="btn btn-primary mt-auto" asp-controller="Order" asp-action="Create" asp-route-id="@drink.Id">Order</a>
                </div>
            </div>
        </div>
    }
</div>
