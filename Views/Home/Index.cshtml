@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to the Bartender App</h1>
    <p class="lead">Order a cocktail, or manage the order queue.</p>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-4 mb-4">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Patrons</h5>
                <p class="card-text">Browse the cocktail menu and place an order for your favorite drink.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Order" asp-action="Menu">View Menu &amp; Order</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Bartenders</h5>
                <p class="card-text">View the cocktail order queue and mark orders ready for pick up.</p>
                <a class="btn btn-success mt-auto" asp-controller="Order" asp-action="Queue">Order Queue</a>
            </div>
        </div>
    </div>
</div>
