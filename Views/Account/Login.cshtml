@{
    ViewData["Title"] = "Staff Login";
}

<h1>Staff Login</h1>
<p>Sign in to view and work the order queue.</p>

<form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" style="max-width: 24rem;">
    <div class="text-danger">@Html.ValidationSummary()</div>
    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="email" name="email" required />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name="password" required />
    </div>
    <button type="submit" class="btn btn-primary">Log In</button>
</form>
